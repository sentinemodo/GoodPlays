# Database (Neon or local docker-compose)
# Local: use ConnectionStrings__Default
ConnectionStrings__Default=Host=localhost;Port=5432;Database=goodplays;Username=goodplays;Password=goodplays
# Railway + Neon plugin injects DATABASE_URL automatically; optional explicit override:
# DATABASE_URL=postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/goodplays?sslmode=require

# Redis (Upstash or local docker-compose)
Redis__ConnectionString=localhost:6379
# Upstash on Railway injects REDIS_URL (rediss://...); optional explicit override:
# REDIS_URL=rediss://default:token@endpoint.upstash.io:6379

# Clerk
CLERK_SECRET_KEY=sk_test_replace_me
Clerk__Authority=https://your-clerk-domain.clerk.accounts.dev
Clerk__SecretKey=
Clerk__WebhookSecret=whsec_replace_me
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_me

# Metadata APIs (Twitch dev portal: use https://sentinemodo.github.io/GoodPlays/ as public URL)
IGDB__ClientId=
IGDB__ClientSecret=
RAWG__ApiKey=
OpenCritic__ApiKey=

# Object storage (Phase 2+)
R2__AccountId=
R2__AccessKeyId=
R2__SecretAccessKey=
R2__BucketName=

# LLM (Phase 1+) — OpenAI-compatible (OpenAI, Ollama, RunPod)
LLM__Provider=openai
LLM__ApiKey=
LLM__Model=gpt-4o-mini
LLM__BaseUrl=https://api.openai.com/v1
# Local Ollama (docker):
# LLM__BaseUrl=http://localhost:11434/v1
# LLM__Model=qwen2.5:7b
# LLM__ApiKey=ollama

# Observability (Phase 1+)
Sentry__Dsn=

# Platform sync (Phase 4)
Steam__ApiKey=
Steam__OpenIdRealm=
Psn__ClientId=
Psn__ClientSecret=

# Frontend
VITE_API_URL=http://localhost:5280
